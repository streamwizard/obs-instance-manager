NODE_ID=
PORT=3000
CADVISOR_URL=http://localhost:8080

# Received from /api/nodes/claim during node setup
REST_API_URL=
NODE_API_KEY=

# Supabase URL — used only for JWKS-based JWT verification (no service role key needed)
SUPABASE_URL=

# Encryption key for OBS WebSocket passwords stored in the database (hex-encoded 32-byte key)
TOKEN_ENCRYPTION_KEY=

# S3-compatible storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=streamwizard-obs
S3_REGION=auto
OBS_CONFIG_BASE=/data/obs-configs
PLUGINS_PATH=/data/obs-plugins
OBS_TEMPLATES_PREFIX=obs-templates/
OBS_DEFAULT_TEMPLATE=default
