# Written by scripts/local/register-node.sh; copy by hand only if you claim a
# node some other way. Used by docker-compose.local.yml (see scripts/local/up.sh).

# ── From POST /api/obs-nodes/claim ────────────────────────────────────────────────
NODE_ID=
NODE_API_KEY=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# ── Host services, as seen from inside the manager container ──────────────────
REST_API_URL=http://host.docker.internal:8080
SUPABASE_URL=http://host.docker.internal:54321

# ── Compose ───────────────────────────────────────────────────────────────────
TAILSCALE_IP=127.0.0.1
API_HOST_PORT=3100
# Absolute path; instance configs and plugins live under it.
LOCAL_DATA_DIR=
OBS_CONFIG_BASE=
PLUGINS_PATH=
PANEL_ORIGIN=http://localhost:3000,http://localhost:3003

# ── Instance containers (see src/clients/instance-spec.ts) ────────────────────
# Built from the obs-cloud-selkies repo: docker compose build there.
OBS_INSTANCE_IMAGE=obs-cloud-container-local:selkies
OBS_VIEWER=selkies
OBS_GPU_MODE=direct
OBS_GL_MODE=d3d12
# A local test user rarely has Twitch connected with the stream-key scope.
ALLOW_MISSING_STREAM_KEY=true
DEBUG=true
